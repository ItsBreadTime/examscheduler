{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/configuration-schema.json",
  "name": "exam-scheduler",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  // Serve the built SPA (npm run build) from the same worker; unmatched paths
  // fall through to the API handler in worker/index.ts.
  "assets": {
    "directory": "./web-dist",
    "not_found_handling": "single-page-application"
  },
  // Provision with `npm run cloud:provision` (wrangler r2 bucket create / wrangler d1 create);
  // the script fills database_id in here, applies migrations/ and deploys.
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "exam-scheduler-blobs" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "exam-scheduler",
      "database_id": "51af0f77-ec30-46c6-9da4-ac8aa260f093",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true },
  // Cross-isolate mutation rate limiting for the anonymous write surface
  // (POST /projects, PUT revisions, POST/DELETE shares). Remove this block if
  // the deployed wrangler version rejects the beta binding; the worker falls
  // back to a per-isolate in-memory limiter.
  "unsafe": {
    "bindings": [
      { "name": "RATE_LIMITER", "type": "ratelimit", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }
    ]
  }
}
