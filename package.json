{
  "name": "exam-scheduler-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "check": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.app.json",
    "build": "tsc && vite build",
    "schedule": "node src/cli.ts",
    "validate": "node src/validate.ts",
    "dev": "vite",
    "cloud:dev": "node scripts/dev-worker.ts",
    "cloud:provision": "node scripts/provision-cloud.ts",
    "cloud:deploy": "npm run build && npx wrangler deploy",
    "cloud:migrate": "npx wrangler d1 migrations apply exam-scheduler --remote",
    "preview": "vite preview --host 127.0.0.1",
    "build:core": "tsc"
  },
  "dependencies": {
    "svelte": "^5.57.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^24.0.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.0",
    "vite": "^8.2.2"
  }
}
